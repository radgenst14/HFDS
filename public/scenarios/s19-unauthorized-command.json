{
  "id": "s19-unauthorized-command",
  "name": "Unauthorized external command rejected",
  "description": "Commands arrive over an external network (simulated). Vehicle Control rejects an unauthenticated command and any direct actuation command from outside the car; an authenticated service provider's set-speed request is applied by the Driver Assist System. Every attempt is logged.",
  "customerScenario": null,
  "sequenceDiagram": null,
  "optional": true,
  "requirements": ["IR18", "IR19", "IR21", "SR9"],
  "caption": {
    "summary": "Command-source authentication (IR18, IR19). Illustrative only: no real network or cryptography (A-62).",
    "steps": [
      "2 s: the driver presses the HFDS button; 4 s: hands off the wheel.",
      "10 s: an unauthenticated 'accelerate' command arrives from an external network. It is rejected (IR19) and logged; the speed does not change.",
      "13 s: the same command arrives while an authenticated service provider is connected. Vehicle Control still rejects it, because only the in-car Driver Assist System or the driver may steer, accelerate or brake (IR18).",
      "16 s: the authenticated provider requests a 60 mph set speed. The Driver Assist System applies it, and the car slows to 60 mph."
    ],
    "watchFor": [
      "Speed unchanged after each rejected command.",
      "Rejection warnings in the event log, tagged IR18, IR19, IR21 and SR9.",
      "Set speed changes to 60 mph at 16 s."
    ]
  },
