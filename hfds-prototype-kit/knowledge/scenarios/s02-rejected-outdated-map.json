{
  "id": "s02-rejected-outdated-map",
  "name": "Activation rejected: outdated LiDAR map",
  "description": "The stored LiDAR map is 9 months old. Pressing the HFDS button shows an error and 'Update needed'. After the map update downloads, HFDS can engage.",
